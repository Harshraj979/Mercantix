{
  "name": "mercantix-root",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "npm run generate --workspace=@mercantix/database",
    "db:migrate": "npm run migrate --workspace=@mercantix/database",
    "db:studio": "npm run studio --workspace=@mercantix/database"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
